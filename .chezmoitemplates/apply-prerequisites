{{- $missing := list -}}
{{- $manager := includeTemplate "linux-package-manager" . -}}
{{- if not (lookPath "git") -}}
{{- $missing = append $missing "git (source checkout and Git externals)" -}}
{{- end -}}
{{- if and (or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux")) (not (stat "/bin/bash")) -}}
{{- $missing = append $missing "/bin/bash (lifecycle scripts)" -}}
{{- end -}}
{{- if eq .chezmoi.os "darwin" -}}
{{- if not (lookPath "curl") -}}
{{- $missing = append $missing "curl (Homebrew bootstrap)" -}}
{{- end -}}
{{- else if $manager -}}
{{- if and (ne .chezmoi.username "root") (not (lookPath "sudo")) -}}
{{- $missing = append $missing "sudo (non-root package provisioning)" -}}
{{- end -}}
{{- if not (lookPath $manager) -}}
{{- $missing = append $missing (printf "%s (package provisioning)" $manager) -}}
{{- end -}}
{{- end -}}
{{- if $missing -}}
{{- fail (printf "Cannot apply dotfiles: missing prerequisites: %s. Install them before running chezmoi init/apply." (join ", " $missing)) -}}
{{- end -}}
