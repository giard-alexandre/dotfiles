    "plugin_id": "ez-corp.git-status",
    "name": "Git Status",
    "version": "1.5.0",
    "min_herdr_version": "0.7.5",
    "description": "Git working-tree status (staged/modified/untracked, ✓ when clean) per space.",
    "manifest_path": "\\\\?\\C:\\Users\\agiard\\.config\\herdr\\plugins\\github\\ez-corp.git-status-ea1130cc59c6\\herdr-plugin.toml",
    "plugin_root": "\\\\?\\C:\\Users\\agiard\\.config\\herdr\\plugins\\github\\ez-corp.git-status-ea1130cc59c6",
    "enabled": true,
    "platforms": [
      "linux",
      "macos",
      "windows"
    ],
    "build": [
      {
        "command": [
          "cargo",
          "build",
          "--release"
        ]
      }
    ],
    "startup": [
      {
        "command": [
          "./target/release/git-status",
          "--restore"
        ]
      }
    ],
    "actions": [
      {
        "id": "report",
        "title": "Git status report",
        "contexts": [
          "workspace"
        ],
        "command": [
          "./target/release/git-status",
          "--once"
        ]
      },
      {
        "id": "status-disable",
        "title": "Disable git status updater",
        "command": [
          "./target/release/git-status",
          "--disable"
        ]
      },
      {
        "id": "status-enable",
        "title": "Enable git status updater",
        "command": [
          "./target/release/git-status",
          "--enable"
        ]
      },
      {
        "id": "status-toggle",
        "title": "Toggle git status updater",
        "command": [
          "./target/release/git-status",
          "--toggle"
        ]
      }
    ],
    "panes": [
      {
        "id": "dashboard",
        "title": "Git status",
        "placement": "overlay",
        "command": [
          "./target/release/git-status",
          "--interval",
          "3"
        ]
      }
    ],
    "source": {
