[
  {
    "plugin_id": "chmarax.gitview",
    "name": "gitview",
    "version": "0.1.0",
    "min_herdr_version": "0.7.0",
    "description": "Two-pane git view: changed files + diff, Enter opens nvim",
    "manifest_path": "\\\\?\\C:\\Users\\agiard\\.config\\herdr\\plugins\\github\\chmarax.gitview-57cd0959dba0\\herdr-plugin.toml",
    "plugin_root": "\\\\?\\C:\\Users\\agiard\\.config\\herdr\\plugins\\github\\chmarax.gitview-57cd0959dba0",
    "enabled": true,
    "platforms": [
      "macos",
      "linux"
    ],
    "build": [
      {
        "command": [
          "bash",
          "herdr/install.sh"
        ]
      }
    ],
    "actions": [
      {
        "id": "toggle",
        "title": "gitview: toggle sidebar",
        "contexts": [
          "pane",
          "workspace"
        ],
        "command": [
          "sh",
          "-c",
          "exec sh \"$HERDR_PLUGIN_ROOT/herdr/run.sh\" toggle"
        ]
      },
      {
        "id": "toggle-tab",
        "title": "gitview: toggle in own tab",
        "contexts": [
          "pane",
          "workspace"
        ],
        "command": [
          "sh",
          "-c",
          "exec sh \"$HERDR_PLUGIN_ROOT/herdr/run.sh\" toggle-tab"
        ]
      }
    ],
    "panes": [
      {
        "id": "ask",
        "title": "gitview: confirm",
        "placement": "overlay",
        "command": [
          "sh",
          "-c",
          "exec sh \"$HERDR_PLUGIN_ROOT/herdr/run.sh\" ask"
        ]
      },
      {
        "id": "list",
        "title": "gitview: files",
        "placement": "split",
        "command": [
          "sh",
          "-c",
          "exec sh \"$HERDR_PLUGIN_ROOT/herdr/run.sh\" list"
        ]
      },
      {
        "id": "pick-agent",
        "title": "gitview: send to agent",
        "placement": "overlay",
        "command": [
          "sh",
          "-c",
          "exec sh \"$HERDR_PLUGIN_ROOT/herdr/run.sh\" pick-agent"
        ]
      },
      {
        "id": "preview",
        "title": "gitview: diff",
        "placement": "split",
        "command": [
          "sh",
          "-c",
          "exec sh \"$HERDR_PLUGIN_ROOT/herdr/run.sh\" preview"
        ]
      }
    ],
