        "command": [
          "node",
          "bin/on-event.js"
        ]
      },
      {
        "on": "pane.created",
        "command": [
          "node",
          "bin/on-event.js"
        ]
      },
      {
        "on": "pane.exited",
        "command": [
          "node",
          "bin/on-event.js"
        ]
      },
      {
        "on": "workspace.closed",
        "command": [
          "node",
          "bin/on-event.js"
        ]
      },
      {
        "on": "workspace.created",
        "command": [
          "node",
          "bin/on-event.js"
        ]
      }
