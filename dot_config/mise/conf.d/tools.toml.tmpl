[tools]
# global tool versions go here
# Tools
neovim = 'latest'
bat = 'latest'
# Delta 0.18.2 is the last release with Intel macOS binaries.
delta = '{{ if and (eq .chezmoi.os "darwin") (eq .chezmoi.arch "amd64") }}0.18.2{{ else }}latest{{ end }}'
dprint = 'latest'
eza = 'latest'
# Pin fd on Intel Macs; use the latest release on other platforms.
fd = '{{ if and (eq .chezmoi.os "darwin") (eq .chezmoi.arch "amd64") }}10.3.0{{ else }}latest{{ end }}'
fzf = 'latest'
fx = 'latest'
gojq = 'latest'
jqp = 'latest'
helix = 'latest'
ripgrep = 'latest'
rtk = 'latest'
starship = 'latest'
worktrunk = 'latest'
"npm:@oh-my-pi/pi-coding-agent" = 'latest'
herdr = 'latest'

# Languages
bun = 'latest'
dotnet = ['10', 'latest']
go = 'latest'
go-jsonnet = 'latest'
jsonnet-bundler = 'latest'
node = 'latest'
python = 'latest'
rust = 'latest'

# Kubernetes
kubectl = 'latest'
k9s = 'latest'
kubie = 'latest'
krew = 'latest'
helm = 'latest'
tanka = 'latest'

[settings]
minimum_release_age_excludes = ["npm:@oh-my-pi/pi-coding-agent", "herdr"]
