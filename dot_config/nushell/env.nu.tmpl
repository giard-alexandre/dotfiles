# Include the system CA store in Node's trusted certificates.
$env.NODE_USE_SYSTEM_CA = '1'

# Cache compiled Node modules between runs.
$env.NODE_COMPILE_CACHE = ($env.XDG_CACHE_HOME? | default {{ joinPath .chezmoi.homeDir ".cache" | quote }} | path join 'node' 'compile-cache')

{{ if and (or (eq .chezmoi.os "linux") (eq .chezmoi.os "darwin")) (not (and (eq .chezmoi.os "darwin") (eq .chezmoi.arch "amd64"))) -}}
# Atuin's generated hooks invoke its executable directly, including in standalone Nu.
$env.ATUIN_CONFIG_DIR = {{ joinPath .chezmoi.homeDir ".config/atuin" | quote }}
$env.PATH = ($env.PATH | prepend {{ joinPath .chezmoi.homeDir ".local/share/mise/shims" | quote }} | uniq)
{{ end -}}
