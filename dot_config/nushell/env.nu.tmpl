# Nushell Environment Configuration
# This file runs before config.nu and sets up environment variables

# XDG Base Directories
$env.XDG_CONFIG_HOME = ($env.HOME | path join ".config")
$env.XDG_DATA_HOME = ($env.HOME | path join ".local" "share")
$env.XDG_STATE_HOME = ($env.HOME | path join ".local" "state")
$env.XDG_CACHE_HOME = ($env.HOME | path join ".cache")

# Terminal
$env.TERM = "xterm-256color"
$env.CLICOLOR = true

# Editors
$env.VIM = "nvim"
$env.EDITOR = $env.VIM
$env.VEDITOR = "code"

# Git
$env.GIT_PAGER = "delta"
$env.GIT_EDITOR = $env.VIM

# Dotfiles
$env.DOTFILES = ($env.HOME | path join ".dotfiles")

# Projects (from chezmoi templates)
$env.PROJECTS = {{ .personal_project_folder }}
{{ if .has_work_profile -}}
$env.PROJECTS_WORK = {{ .work_project_folder }}
{{- end }}

# PATH initialization
$env.PATH = ($env.PATH | split row (char esep))

# Core paths
$env.PATH = ($env.PATH | prepend ($env.HOME | path join ".local" "bin"))
$env.PATH = ($env.PATH | prepend ($env.DOTFILES | path join "bin"))
$env.PATH = ($env.PATH | prepend ($env.HOME | path join ".bin"))

# Go
$env.GOPATH = ($env.HOME | path join ".go")
$env.PATH = ($env.PATH | prepend ($env.GOPATH | path join "bin"))

# Kubernetes
$env.PATH = ($env.PATH | prepend ($env.HOME | path join ".krew" "bin"))

# .NET
if ("~/.dotnet" | path expand | path exists) {
  $env.DOTNET_ROOT = ($env.HOME | path join ".dotnet")
  $env.PATH = ($env.PATH | prepend $env.DOTNET_ROOT)
  $env.PATH = ($env.PATH | prepend ($env.DOTNET_ROOT | path join "tools"))
}

# /usr/local/bin (common on macOS)
$env.PATH = ($env.PATH | prepend "/usr/local/bin")
