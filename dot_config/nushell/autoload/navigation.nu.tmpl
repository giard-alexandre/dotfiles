# Project navigation functions

# Change to personal projects directory
export def --env c [project?: string] {
  if ($project | is-empty) {
    cd $env.PROJECTS
  } else {
    cd ($env.PROJECTS | path join $project)
  }
}

# Completion for c command
export extern "c" [
  project?: string@"nu-complete c"
]

def "nu-complete c" [] {
  ls $env.PROJECTS
  | where type == dir
  | get name
  | path basename
}

