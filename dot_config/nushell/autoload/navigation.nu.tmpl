# Project navigation functions

# Change to personal projects directory
export def --env c [
  project?: string@"nu-complete c"  # Project name with tab completion
] {
  if ($project | is-empty) {
    cd $env.PROJECTS
  } else {
    cd ($env.PROJECTS | path join $project)
  }
}

def "nu-complete c" [] {
  ls $env.PROJECTS
  | where type == dir
  | get name
  | path basename
}

