style = "auto"

# Sync is opt-in; existing chezmoi configurations default to local history.
auto_sync = {{ get . "atuin_sync" | default false }}
{{ if (get . "atuin_sync" | default false) -}}
sync_address = {{ get . "atuin_sync_address" | default "https://api.atuin.sh" | quote }}
{{ end -}}

{{ if not (and (eq .chezmoi.os "darwin") (eq .chezmoi.arch "amd64")) -}}
# Intel's Atuin 18.10.0 lacks daemon-fuzzy and daemon autostart.
search_mode = "daemon-fuzzy"

[daemon]
enabled = true
autostart = true

[ai]
enabled = false
{{ end -}}
