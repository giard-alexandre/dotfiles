{{ if (or (eq .chezmoi.os "linux") (eq .chezmoi.os "darwin")) -}}
#!/bin/zsh
set -euo pipefail

{{- $configPath := joinPath .chezmoi.homeDir ".config/mise/config.toml" }}
# {{ $configPath }} hash: {{ if stat $configPath }}{{ include $configPath | sha256sum }}{{ else }}{{ include "dot_config/mise/create_config.toml" | sha256sum }}{{ end }}
# Re-run when managed mise configuration changes, including the tool inventory.
{{ range glob (joinPath .chezmoi.sourceDir "dot_config/mise/conf.d/*") -}}
# {{ base . }} hash: {{ includeTemplate . $ | sha256sum }}
{{ end -}}
{{- $mise := joinPath .chezmoi.homeDir ".local/bin/mise" }}
{{ $mise | quote }} install

# Generate the Nushell prompt only after Starship is installed.
{{- $prompt := joinPath .chezmoi.homeDir ".local/share/nushell/vendor/autoload/starship.nu" }}
mkdir -p {{ dir $prompt | quote }}
{{ if eq .chezmoi.os "darwin" -}}
{{ $starship := joinPath (dir (includeTemplate "brew-executable" .)) "starship" -}}
{{ $starship | quote }} init nu > {{ $prompt | quote }}
{{ else -}}
{{ $mise | quote }} exec -- starship init nu > {{ $prompt | quote }}
{{ end -}}

# setup RTK for usage
mkdir -p {{ joinPath .chezmoi.homeDir ".claude" | quote }}
{{ $mise | quote }} exec -- rtk init -g

{{ end -}}
