{{- if (or (eq .chezmoi.os "linux") (eq .chezmoi.os "darwin")) -}}
{{- /*
    Render-time no-op: when the account's configured login shell already is
    the default target zsh (or a previously saved choice), render nothing so
    chezmoi skips the script. Lookups are wrapped in `sh -c '... || true'`
    because a non-zero exit from `output` would abort rendering.
*/ -}}
{{-   $login := "" -}}
{{-   $targets := list -}}
{{-   if eq .chezmoi.os "darwin" -}}
{{-     $login = output "/bin/sh" "-c" "dscl . -read \"/Users/$1\" UserShell 2>/dev/null || true" "sh" .chezmoi.username | trim | trimPrefix "UserShell:" | trim -}}
{{-     $targets = list (ternary "/usr/local/bin/zsh" "/opt/homebrew/bin/zsh" (eq .chezmoi.arch "amd64")) -}}
{{-   else -}}
{{-     $entry := output "/bin/sh" "-c" "getent passwd \"$1\" 2>/dev/null || true" "sh" .chezmoi.username | trim -}}
{{-     if $entry -}}
{{-       $login = splitList ":" $entry | last | trim -}}
{{-     end -}}
{{-     range (list "/bin/zsh" "/usr/bin/zsh") -}}
{{-       if stat . -}}
{{-         $targets = append $targets . -}}
{{-       end -}}
{{-     end -}}
{{-   end -}}
{{-   $stateFile := env "DEFAULT_SHELL_STATE_FILE" -}}
{{-   if not $stateFile -}}
{{-     $stateFile = joinPath (env "XDG_STATE_HOME" | default (joinPath .chezmoi.homeDir ".local" "state")) "chezmoi" "default-shell" -}}
{{-   end -}}
{{-   if stat $stateFile -}}
{{-     $saved := include $stateFile | regexFind "(?m)^zsh_path=.*$" | trimPrefix "zsh_path=" | trim -}}
{{-     if and $saved (stat $saved) -}}
{{-       $targets = append $targets $saved -}}
{{-     end -}}
{{-   end -}}
{{-   if not (and $login (has $login $targets)) -}}
#!/bin/bash
# Make zsh the account's login shell without ever failing the apply.
# System paths can be overridden (tests only) through DEFAULT_SHELL_* variables.
set -uo pipefail

OS={{ .chezmoi.os | squote }}
ACCOUNT={{ .chezmoi.username | squote }}
DEFAULT_BREW_PREFIX={{ ternary "/usr/local" "/opt/homebrew" (eq .chezmoi.arch "amd64") | squote }}
PASSWD_FILE="${DEFAULT_SHELL_PASSWD_FILE:-/etc/passwd}"
NSSWITCH_FILE="${DEFAULT_SHELL_NSSWITCH_FILE:-/etc/nsswitch.conf}"
SHELLS_FILE="${DEFAULT_SHELL_SHELLS_FILE:-/etc/shells}"
SSSD_CONF_DIR="${DEFAULT_SHELL_SSSD_CONF_DIR:-/etc/sssd/conf.d}"
SSSD_SNIPPET="$SSSD_CONF_DIR/50-chezmoi-shell.conf"
STATE_FILE="${DEFAULT_SHELL_STATE_FILE:-${XDG_STATE_HOME:-$HOME/.local/state}/chezmoi/default-shell}"
TTY_DEVICE="${DEFAULT_SHELL_TTY:-/dev/tty}"

info() { printf '%s\n' "$*"; }
warn() { printf '\033[0;33mWarning: %s\033[0m\n' "$*" >&2; }
finish() {
    echo -e "\0033[0;32m>>>>> Finish Setting Up zsh as default shell <<<<<\033[0m"
    exit 0
}

as_root() {
    {{ template "run-as-root" dict "chezmoi" .chezmoi "command" "\"$@\"" -}}
}

echo -e "\0033[0;32m>>>>> Set Zsh as default Shell <<<<<\033[0m"

# --- Saved answers (key=value; never sourced) --------------------------------
state_get() {
    local line
    [ -r "$STATE_FILE" ] || return 1
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            "$1="*) printf '%s\n' "${line#*=}"; return 0 ;;
        esac
    done < "$STATE_FILE"
    return 1
}

state_set() {
    local tmp="$STATE_FILE.tmp.$$"
    if mkdir -p "$(dirname "$STATE_FILE")" && {
        if [ -f "$STATE_FILE" ]; then grep -v "^$1=" "$STATE_FILE"; fi
        printf '%s=%s\n' "$1" "$2"
    } > "$tmp" && mv "$tmp" "$STATE_FILE"; then
        return 0
    fi
    rm -f "$tmp"
    warn "Could not save $1 to $STATE_FILE; you may be asked again next time."
}

# --- Prompting -----------------------------------------------------------------
PROMPT_FD=""
if [ -t 0 ]; then
    PROMPT_FD=0
elif { exec 3<"$TTY_DEVICE"; } 2>/dev/null; then
    PROMPT_FD=3
fi

ask() {
    # ask PROMPT -> answer on stdout; fails when no terminal is available.
    local reply
    [ -n "$PROMPT_FD" ] || return 1
    printf '%s' "$1" >&2
    IFS= read -r -u "$PROMPT_FD" reply || return 1
    printf '%s\n' "$reply"
}

# --- Login shell lookup ---------------------------------------------------------
login_shell() {
    if [ "$OS" = "darwin" ]; then
        dscl . -read "/Users/$ACCOUNT" UserShell 2>/dev/null | sed -n 's/^UserShell:[[:space:]]*//p' | head -n 1
    else
        getent passwd "$ACCOUNT" 2>/dev/null | head -n 1 | cut -d: -f7
    fi
}

resolve_path() {
    local resolved
    resolved=$(realpath "$1" 2>/dev/null) && [ -n "$resolved" ] && { printf '%s\n' "$resolved"; return; }
    resolved=$(readlink -f "$1" 2>/dev/null) && [ -n "$resolved" ] && { printf '%s\n' "$resolved"; return; }
    printf '%s\n' "$1"
}

zsh_version() {
    # shellcheck disable=SC2016 # expanded by the candidate zsh, not here
    [ -x "$1" ] && "$1" -c 'echo $ZSH_VERSION' 2>/dev/null </dev/null | head -n 1
}

CURRENT_SHELL="$(login_shell)"
CURRENT_REAL=""
[ -n "$CURRENT_SHELL" ] && CURRENT_REAL="$(resolve_path "$CURRENT_SHELL")"

# --- Candidate discovery ----------------------------------------------------------
CAND_PATHS=()
CAND_REALS=()
CAND_VERSIONS=()
CAND_KINDS=()

add_candidate() {
    local path="$1" kind="$2" real version i
    [ -n "$path" ] && [ -x "$path" ] || return 0
    real="$(resolve_path "$path")"
    for i in "${!CAND_REALS[@]}"; do
        if [ "${CAND_REALS[$i]}" = "$real" ]; then
            # Same binary: show the path the account already uses, if any.
            [ "$path" = "$CURRENT_SHELL" ] && CAND_PATHS[i]="$path"
            return 0
        fi
    done
    version="$(zsh_version "$path")"
    [ -n "$version" ] || return 0
    CAND_PATHS+=("$path")
    CAND_REALS+=("$real")
    CAND_VERSIONS+=("$version")
    CAND_KINDS+=("$kind")
}

BREW_ZSH=""
if [ "$OS" = "darwin" ]; then
    brew_prefix="${DEFAULT_SHELL_BREW_PREFIX:-}"
    if [ -z "$brew_prefix" ]; then
        for brew in "$(command -v brew 2>/dev/null)" {{ includeTemplate "brew-executable" . | squote }}; do
            if [ -n "$brew" ] && [ -x "$brew" ]; then
                brew_prefix="$("$brew" --prefix 2>/dev/null)" && [ -n "$brew_prefix" ] && break
            fi
            brew_prefix=""
        done
    fi
    BREW_ZSH="${brew_prefix:-$DEFAULT_BREW_PREFIX}/bin/zsh"
    add_candidate "$BREW_ZSH" "Homebrew"
fi

IFS=':' read -r -a SYSTEM_ZSHS <<< "${DEFAULT_SHELL_ZSH_CANDIDATES:-/bin/zsh:/usr/bin/zsh}"
for path in "${SYSTEM_ZSHS[@]}"; do
    if [ "$OS" = "darwin" ]; then add_candidate "$path" "macOS system"; else add_candidate "$path" "system package"; fi
done
while IFS= read -r path; do
    add_candidate "$path" "PATH"
done < <(type -ap zsh 2>/dev/null)

if [ "${#CAND_PATHS[@]}" -eq 0 ]; then
    warn "No working zsh found; login shell left unchanged. Install zsh and re-run chezmoi apply."
    finish
fi

# Default: Homebrew zsh on macOS, package-manager zsh on Linux. Never `command -v zsh`.
DEFAULT_INDEX=""
want_kind="system package"
[ "$OS" = "darwin" ] && want_kind="Homebrew"
for i in "${!CAND_PATHS[@]}"; do
    if [ "${CAND_KINDS[$i]}" = "$want_kind" ]; then DEFAULT_INDEX="$i"; break; fi
done
if [ -z "$DEFAULT_INDEX" ] && [ "$OS" = "darwin" ]; then
    for i in "${!CAND_PATHS[@]}"; do
        if [ "${CAND_KINDS[$i]}" = "macOS system" ]; then DEFAULT_INDEX="$i"; break; fi
    done
    warn "Homebrew zsh ($BREW_ZSH) not found; falling back to ${CAND_PATHS[${DEFAULT_INDEX:-0}]}."
fi
DEFAULT_INDEX="${DEFAULT_INDEX:-0}"

# --- Choose the target zsh ----------------------------------------------------------
ZSH_PATH=""
saved_path="$(state_get zsh_path)"
if [ -n "$saved_path" ]; then
    if [ -n "$(zsh_version "$saved_path")" ]; then
        ZSH_PATH="$saved_path"
        info "Using saved zsh choice: $ZSH_PATH (reset: remove zsh_path from $STATE_FILE)"
    else
        warn "Saved zsh $saved_path no longer exists or does not run; choosing again."
    fi
fi

if [ -z "$ZSH_PATH" ]; then
    if [ "${#CAND_PATHS[@]}" -eq 1 ]; then
        ZSH_PATH="${CAND_PATHS[0]}"
    else
        width=0
        for path in "${CAND_PATHS[@]}"; do [ "${#path}" -gt "$width" ] && width="${#path}"; done
        info "Multiple zsh installations found:"
        for i in "${!CAND_PATHS[@]}"; do
            label="(${CAND_KINDS[$i]})"
            [ "${CAND_REALS[$i]}" = "$CURRENT_REAL" ] && label="$label (current login shell)"
            [ "$i" = "$DEFAULT_INDEX" ] && label="$label [default]"
            printf '  %d) %-*s  %-8s %s\n' "$((i + 1))" "$width" "${CAND_PATHS[$i]}" "${CAND_VERSIONS[$i]}" "$label"
        done
        if answer="$(ask "Which zsh should be your login shell? [$((DEFAULT_INDEX + 1))]: ")"; then
            case "$answer" in
                "") ZSH_PATH="${CAND_PATHS[$DEFAULT_INDEX]}" ;;
                *[!0-9]*) ;;
                *) [ "$answer" -ge 1 ] && [ "$answer" -le "${#CAND_PATHS[@]}" ] && ZSH_PATH="${CAND_PATHS[$((answer - 1))]}" ;;
            esac
            if [ -z "$ZSH_PATH" ]; then
                ZSH_PATH="${CAND_PATHS[$DEFAULT_INDEX]}"
                warn "Invalid choice '$answer'; using the default $ZSH_PATH."
            fi
            state_set zsh_path "$ZSH_PATH"
        else
            ZSH_PATH="${CAND_PATHS[$DEFAULT_INDEX]}"
            info "No terminal available; using the default $ZSH_PATH."
        fi
    fi
fi

if [ "$CURRENT_SHELL" = "$ZSH_PATH" ]; then
    info "Login shell is already $ZSH_PATH."
    finish
fi

info "Changing login shell for $ACCOUNT from ${CURRENT_SHELL:-unknown} to $ZSH_PATH"

ensure_in_shells() {
    if [ -f "$SHELLS_FILE" ] && grep -qxF "$ZSH_PATH" "$SHELLS_FILE"; then
        return 0
    fi
    info "Adding $ZSH_PATH to $SHELLS_FILE"
    if ! printf '%s\n' "$ZSH_PATH" | as_root tee -a "$SHELLS_FILE" > /dev/null; then
        warn "Could not add $ZSH_PATH to $SHELLS_FILE (sudo unavailable or denied). Fix manually: echo '$ZSH_PATH' | sudo tee -a $SHELLS_FILE && chsh -s '$ZSH_PATH'"
        finish
    fi
}

# --- Method: chsh (local accounts and macOS) -------------------------------------------
use_chsh() {
    ensure_in_shells
    if chsh -s "$ZSH_PATH"; then
        info "Login shell changed to $ZSH_PATH."
    else
        warn "chsh failed; login shell unchanged. Fix manually: chsh -s '$ZSH_PATH'"
    fi
    finish
}

if [ "$OS" = "darwin" ] || cut -d: -f1 "$PASSWD_FILE" 2>/dev/null | grep -qxF "$ACCOUNT"; then
    use_chsh
fi

# --- Method: SSSD override_shell ---------------------------------------------------------
sssd_in_use() {
    grep -E '^[[:space:]]*passwd:' "$NSSWITCH_FILE" 2>/dev/null | grep -qw sss &&
        systemctl is-active --quiet sssd 2>/dev/null
}

if ! sssd_in_use; then
    warn "$ACCOUNT is not in $PASSWD_FILE and is not served by SSSD (LDAP, winbind, OS Login, ...); login shell left unchanged. Ask the directory administrator to set your login shell to $ZSH_PATH."
    finish
fi

SSSD_MANUAL="Fix manually: printf '[nss]\\noverride_shell = $ZSH_PATH\\n' | sudo tee $SSSD_SNIPPET && sudo chown root:root $SSSD_SNIPPET && sudo chmod 600 $SSSD_SNIPPET && sudo sss_cache -E && sudo systemctl restart sssd"

sssd_decision="$(state_get sssd_override)"
case "$sssd_decision" in
    no)
        info "Skipping SSSD shell override (saved answer: no; reset: remove sssd_override from $STATE_FILE)."
        finish
        ;;
    yes)
        info "Applying SSSD shell override (saved answer: yes)."
        ;;
    *)
        info "$ACCOUNT is a directory account served by SSSD, so chsh cannot change its shell."
        info "Setting override_shell in $SSSD_SNIPPET changes the login shell for EVERY SSSD user on this machine."
        if ! answer="$(ask "Apply the SSSD override with $ZSH_PATH? [y/N]: ")"; then
            warn "No terminal available to confirm the SSSD override; login shell left unchanged. $SSSD_MANUAL"
            finish
        fi
        case "$answer" in
            [Yy] | [Yy][Ee][Ss]) state_set sssd_override yes ;;
            *)
                state_set sssd_override no
                warn "SSSD override declined; login shell left unchanged. $SSSD_MANUAL"
                finish
                ;;
        esac
        ;;
esac

remove_snippet() {
    [ -e "$SSSD_SNIPPET" ] || return 0
    as_root rm -f "$SSSD_SNIPPET" || warn "Could not remove $SSSD_SNIPPET; remove it manually."
}

# Ask for root once up front so a denial stops here instead of prompting per step.
if ! as_root true; then
    warn "sudo is unavailable or was denied; login shell left unchanged. $SSSD_MANUAL"
    finish
fi

ensure_in_shells
if ! { as_root mkdir -p "$SSSD_CONF_DIR" &&
    printf '[nss]\noverride_shell = %s\n' "$ZSH_PATH" | as_root tee "$SSSD_SNIPPET" > /dev/null &&
    as_root chown root:root "$SSSD_SNIPPET" &&
    as_root chmod 600 "$SSSD_SNIPPET"; }; then
    warn "Could not write $SSSD_SNIPPET (sudo unavailable or denied)."
    remove_snippet
    warn "$SSSD_MANUAL"
    finish
fi

if command -v sssctl > /dev/null 2>&1 && ! as_root sssctl config-check; then
    remove_snippet
    warn "sssctl config-check rejected the configuration; removed $SSSD_SNIPPET. Login shell left unchanged."
    finish
fi

as_root sss_cache -E || warn "sss_cache -E failed; cached entries may be stale."
if as_root systemctl restart sssd && [ "$(login_shell)" = "$ZSH_PATH" ]; then
    info "Login shell is now $ZSH_PATH via $SSSD_SNIPPET."
    finish
fi

remove_snippet
as_root systemctl restart sssd || warn "Could not restart sssd; run: sudo systemctl restart sssd"
warn "getent does not report $ZSH_PATH after the SSSD override; removed $SSSD_SNIPPET. $SSSD_MANUAL"
finish
{{   end -}}
{{ end -}}
