{{- if (or (eq .chezmoi.os "linux") (eq .chezmoi.os "darwin")) -}}
{{- /*
    Render-time no-op: when the account's configured login shell already is
    a working default target zsh (or a working saved choice), render nothing so
    chezmoi skips the script. All lookups run in `sh -c` scripts that always
    exit 0, because a failing `output` or `include` would abort the whole apply.
*/ -}}
{{-   $login := "" -}}
{{-   $targets := list -}}
{{-   if eq .chezmoi.os "darwin" -}}
{{-     $login = output "/bin/sh" "-c" "dscl . -read \"/Users/$1\" UserShell 2>/dev/null || true" "sh" .chezmoi.username | trim | trimPrefix "UserShell:" | trim -}}
{{-     $targets = list (ternary "/usr/local/bin/zsh" "/opt/homebrew/bin/zsh" (eq .chezmoi.arch "amd64")) -}}
{{-   else -}}
{{-     $entry := output "/bin/sh" "-c" "getent passwd \"$1\" 2>/dev/null || true" "sh" .chezmoi.username | trim -}}
{{-     if $entry -}}
{{-       $login = splitList ":" $entry | last | trim -}}
{{-     end -}}
{{-     $targets = list "/bin/zsh" "/usr/bin/zsh" -}}
{{-   end -}}
{{-   $stateFile := env "DEFAULT_SHELL_STATE_FILE" -}}
{{-   if not $stateFile -}}
{{-     $stateFile = joinPath (env "XDG_STATE_HOME" | default (joinPath .chezmoi.homeDir ".local" "state")) "chezmoi" "default-shell" -}}
{{-   end -}}
{{- /* Print the targets (plus the saved zsh_path) that run as zsh, like the run-time check. */ -}}
{{-   $probe := `state=$1 targets=$2
works() { [ -x "$1" ] && [ -n "$("$1" -c 'echo $ZSH_VERSION' </dev/null 2>/dev/null)" ] && printf '%s\n' "$1"; }
printf '%s\n' "$targets" | while IFS= read -r p; do [ -z "$p" ] || works "$p"; done
if [ -f "$state" ] && [ -r "$state" ]; then
    saved=$(sed -n 's/^zsh_path=//p' "$state" 2>/dev/null | head -n 1)
    [ -z "$saved" ] || works "$saved"
fi
exit 0` -}}
{{-   $working := output "/bin/sh" "-c" $probe "sh" $stateFile ($targets | join "\n") | splitList "\n" -}}
{{-   if not (and $login (has $login $working)) -}}
#!/bin/bash
# Make zsh the account's login shell without ever failing the apply.
# System paths can be overridden (tests only) through DEFAULT_SHELL_* variables.
set -uo pipefail

OS={{ .chezmoi.os | squote }}
ACCOUNT={{ .chezmoi.username | squote }}
DEFAULT_BREW_PREFIX={{ ternary "/usr/local" "/opt/homebrew" (eq .chezmoi.arch "amd64") | squote }}
PASSWD_FILE="${DEFAULT_SHELL_PASSWD_FILE:-/etc/passwd}"
NSSWITCH_FILE="${DEFAULT_SHELL_NSSWITCH_FILE:-/etc/nsswitch.conf}"
SHELLS_FILE="${DEFAULT_SHELL_SHELLS_FILE:-/etc/shells}"
SSSD_CONF="${DEFAULT_SHELL_SSSD_CONF:-/etc/sssd/sssd.conf}"
SSSD_CONF_DIR="${DEFAULT_SHELL_SSSD_CONF_DIR:-/etc/sssd/conf.d}"
KRB5_CONF="${DEFAULT_SHELL_KRB5_CONF:-/etc/krb5.conf}"
SSSD_SNIPPET="$SSSD_CONF_DIR/50-chezmoi-shell.conf"
STATE_FILE="${DEFAULT_SHELL_STATE_FILE:-${XDG_STATE_HOME:-$HOME/.local/state}/chezmoi/default-shell}"
TTY_DEVICE="${DEFAULT_SHELL_TTY:-/dev/tty}"

info() { printf '%s\n' "$*"; }
warn() { printf '\033[0;33mWarning: %s\033[0m\n' "$*" >&2; }
finish() {
    echo -e "\0033[0;32m>>>>> Finish Setting Up zsh as default shell <<<<<\033[0m"
    exit 0
}

as_root() {
    {{ template "run-as-root" dict "chezmoi" .chezmoi "command" "\"$@\"" -}}
}

echo -e "\0033[0;32m>>>>> Set Zsh as default Shell <<<<<\033[0m"

# --- Saved answers (key=value; never sourced) --------------------------------
state_get() {
    local line
    [ -r "$STATE_FILE" ] || return 1
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            "$1="*) printf '%s\n' "${line#*=}"; return 0 ;;
        esac
    done < "$STATE_FILE"
    return 1
}

state_set() {
    local tmp="$STATE_FILE.tmp.$$"
    if mkdir -p "$(dirname "$STATE_FILE")" && {
        if [ -f "$STATE_FILE" ]; then grep -v "^$1=" "$STATE_FILE"; fi
        printf '%s=%s\n' "$1" "$2"
    } > "$tmp" && mv "$tmp" "$STATE_FILE"; then
        return 0
    fi
    rm -f "$tmp"
    warn "Could not save $1 to $STATE_FILE; you may be asked again next time."
}

# --- Prompting -----------------------------------------------------------------
PROMPT_FD=""
if [ -t 0 ]; then
    PROMPT_FD=0
elif { exec 3<"$TTY_DEVICE"; } 2>/dev/null; then
    PROMPT_FD=3
fi

ask() {
    # ask PROMPT -> answer on stdout; fails when no terminal is available.
    local reply
    [ -n "$PROMPT_FD" ] || return 1
    printf '%s' "$1" >&2
    IFS= read -r -u "$PROMPT_FD" reply || return 1
    # Echo is off when stdin is not the terminal; keep later output on its own line.
    [ "$PROMPT_FD" = 0 ] || printf '\n' >&2
    printf '%s\n' "$reply"
}

# --- Login shell lookup ---------------------------------------------------------
login_shell() {
    if [ "$OS" = "darwin" ]; then
        dscl . -read "/Users/$ACCOUNT" UserShell 2>/dev/null | sed -n 's/^UserShell:[[:space:]]*//p' | head -n 1
    else
        getent passwd "$ACCOUNT" 2>/dev/null | head -n 1 | cut -d: -f7
    fi
}

resolve_path() {
    local resolved
    resolved=$(realpath "$1" 2>/dev/null) && [ -n "$resolved" ] && { printf '%s\n' "$resolved"; return; }
    resolved=$(readlink -f "$1" 2>/dev/null) && [ -n "$resolved" ] && { printf '%s\n' "$resolved"; return; }
    printf '%s\n' "$1"
}

zsh_version() {
    # shellcheck disable=SC2016 # expanded by the candidate zsh, not here
    [ -x "$1" ] && "$1" -c 'echo $ZSH_VERSION' 2>/dev/null </dev/null | head -n 1
}

CURRENT_SHELL="$(login_shell)"
CURRENT_REAL=""
[ -n "$CURRENT_SHELL" ] && CURRENT_REAL="$(resolve_path "$CURRENT_SHELL")"

# --- Candidate discovery ----------------------------------------------------------
CAND_PATHS=()
CAND_REALS=()
CAND_VERSIONS=()
CAND_KINDS=()

add_candidate() {
    local path="$1" kind="$2" real version i
    [ -n "$path" ] && [ -x "$path" ] || return 0
    real="$(resolve_path "$path")"
    for i in "${!CAND_REALS[@]}"; do
        if [ "${CAND_REALS[$i]}" = "$real" ]; then
            # Same binary: show the path the account already uses, if any.
            [ "$path" = "$CURRENT_SHELL" ] && CAND_PATHS[i]="$path"
            return 0
        fi
    done
    version="$(zsh_version "$path")"
    [ -n "$version" ] || return 0
    CAND_PATHS+=("$path")
    CAND_REALS+=("$real")
    CAND_VERSIONS+=("$version")
    CAND_KINDS+=("$kind")
}

BREW_ZSH=""
if [ "$OS" = "darwin" ]; then
    brew_prefix="${DEFAULT_SHELL_BREW_PREFIX:-}"
    if [ -z "$brew_prefix" ]; then
        for brew in "$(command -v brew 2>/dev/null)" {{ includeTemplate "brew-executable" . | squote }}; do
            if [ -n "$brew" ] && [ -x "$brew" ]; then
                brew_prefix="$("$brew" --prefix 2>/dev/null)" && [ -n "$brew_prefix" ] && break
            fi
            brew_prefix=""
        done
    fi
    BREW_ZSH="${brew_prefix:-$DEFAULT_BREW_PREFIX}/bin/zsh"
    add_candidate "$BREW_ZSH" "Homebrew"
fi

IFS=':' read -r -a SYSTEM_ZSHS <<< "${DEFAULT_SHELL_ZSH_CANDIDATES:-/bin/zsh:/usr/bin/zsh}"
for path in "${SYSTEM_ZSHS[@]}"; do
    if [ "$OS" = "darwin" ]; then add_candidate "$path" "macOS system"; else add_candidate "$path" "system package"; fi
done
while IFS= read -r path; do
    add_candidate "$path" "PATH"
done < <(type -ap zsh 2>/dev/null)

if [ "${#CAND_PATHS[@]}" -eq 0 ]; then
    warn "No working zsh found; login shell left unchanged. Install zsh and re-run chezmoi apply."
    finish
fi

# Default: Homebrew zsh on macOS, package-manager zsh on Linux. Never `command -v zsh`.
DEFAULT_INDEX=""
want_kind="system package"
[ "$OS" = "darwin" ] && want_kind="Homebrew"
for i in "${!CAND_PATHS[@]}"; do
    if [ "${CAND_KINDS[$i]}" = "$want_kind" ]; then DEFAULT_INDEX="$i"; break; fi
done
if [ -z "$DEFAULT_INDEX" ] && [ "$OS" = "darwin" ]; then
    for i in "${!CAND_PATHS[@]}"; do
        if [ "${CAND_KINDS[$i]}" = "macOS system" ]; then DEFAULT_INDEX="$i"; break; fi
    done
    warn "Homebrew zsh ($BREW_ZSH) not found; falling back to ${CAND_PATHS[${DEFAULT_INDEX:-0}]}."
fi
DEFAULT_INDEX="${DEFAULT_INDEX:-0}"

# --- Choose the target zsh ----------------------------------------------------------
ZSH_PATH=""
saved_path="$(state_get zsh_path)"
if [ -n "$saved_path" ]; then
    if [ -n "$(zsh_version "$saved_path")" ]; then
        ZSH_PATH="$saved_path"
        info "Using saved zsh choice: $ZSH_PATH (reset: remove zsh_path from $STATE_FILE)"
    else
        warn "Saved zsh $saved_path no longer exists or does not run; choosing again."
    fi
fi

if [ -z "$ZSH_PATH" ]; then
    if [ "${#CAND_PATHS[@]}" -eq 1 ]; then
        ZSH_PATH="${CAND_PATHS[0]}"
    else
        width=0
        for path in "${CAND_PATHS[@]}"; do [ "${#path}" -gt "$width" ] && width="${#path}"; done
        info "Multiple zsh installations found:"
        for i in "${!CAND_PATHS[@]}"; do
            label="(${CAND_KINDS[$i]})"
            [ "${CAND_REALS[$i]}" = "$CURRENT_REAL" ] && label="$label (current login shell)"
            [ "$i" = "$DEFAULT_INDEX" ] && label="$label [default]"
            printf '  %d) %-*s  %-8s %s\n' "$((i + 1))" "$width" "${CAND_PATHS[$i]}" "${CAND_VERSIONS[$i]}" "$label"
        done
        if answer="$(ask "Which zsh should be your login shell? [$((DEFAULT_INDEX + 1))]: ")"; then
            case "$answer" in
                "") ZSH_PATH="${CAND_PATHS[$DEFAULT_INDEX]}" ;;
                *[!0-9]*) ;;
                *) [ "$answer" -ge 1 ] && [ "$answer" -le "${#CAND_PATHS[@]}" ] && ZSH_PATH="${CAND_PATHS[$((answer - 1))]}" ;;
            esac
            if [ -z "$ZSH_PATH" ]; then
                ZSH_PATH="${CAND_PATHS[$DEFAULT_INDEX]}"
                warn "Invalid choice '$answer'; using the default $ZSH_PATH."
            fi
            state_set zsh_path "$ZSH_PATH"
        else
            ZSH_PATH="${CAND_PATHS[$DEFAULT_INDEX]}"
            info "No terminal available; using the default $ZSH_PATH."
        fi
    fi
fi

if [ "$CURRENT_SHELL" = "$ZSH_PATH" ]; then
    info "Login shell is already $ZSH_PATH."
    finish
fi

info "Changing login shell for $ACCOUNT from ${CURRENT_SHELL:-unknown} to $ZSH_PATH"

NEEDS_SUDO={{ ne .chezmoi.username "root" | quote }}
SUDO_REASON=""

as_root_for() {
    # as_root_for REASON CMD...: run CMD as root, first saying why sudo is needed.
    local reason="$1"
    shift
    if [ "$NEEDS_SUDO" = "true" ] && [ "$reason" != "$SUDO_REASON" ]; then
        # stderr, so the message is shown even when output is captured.
        printf 'Using sudo to %s.\n' "$reason" >&2
        SUDO_REASON="$reason"
    fi
    SUDO_PROMPT="[sudo] password for %u (to ${reason//%/%%}): " as_root "$@"
}

ensure_in_shells() {
    if [ -f "$SHELLS_FILE" ] && grep -qxF "$ZSH_PATH" "$SHELLS_FILE"; then
        return 0
    fi
    if ! printf '%s\n' "$ZSH_PATH" |
        as_root_for "add $ZSH_PATH to $SHELLS_FILE, the list of allowed login shells" tee -a "$SHELLS_FILE" > /dev/null; then
        warn "Could not add $ZSH_PATH to $SHELLS_FILE (sudo unavailable or denied). Fix manually: echo '$ZSH_PATH' | sudo tee -a $SHELLS_FILE"
        finish
    fi
}

# --- Method: chsh (local accounts and macOS) -------------------------------------------
use_chsh() {
    ensure_in_shells
    info "chsh may ask for your own login password (not sudo) to confirm the change."
    if chsh -s "$ZSH_PATH"; then
        info "Login shell changed to $ZSH_PATH."
    else
        warn "chsh failed; login shell unchanged. Fix manually: chsh -s '$ZSH_PATH'"
    fi
    finish
}

if [ "$OS" = "darwin" ] || cut -d: -f1 "$PASSWD_FILE" 2>/dev/null | grep -qxF "$ACCOUNT"; then
    use_chsh
fi

# --- Method: SSSD ------------------------------------------------------------------------
# 1. default_shell in the account's [domain/...] section: only affects users of that
#    domain whose directory entry has no shell.
# 2. Only if that has no effect (the directory sets a shell) or the domain is unknown:
#    override_shell in [nss], which replaces the shell of EVERY SSSD user.
sssd_in_use() {
    grep -E '^[[:space:]]*passwd:' "$NSSWITCH_FILE" 2>/dev/null | grep -qw sss &&
        systemctl is-active --quiet sssd 2>/dev/null
}

if ! sssd_in_use; then
    warn "$ACCOUNT is not in $PASSWD_FILE and is not served by SSSD (LDAP, winbind, OS Login, ...); login shell left unchanged. Ask the directory administrator to set your login shell to $ZSH_PATH."
    finish
fi

info "$ACCOUNT is a directory account served by SSSD, so chsh cannot change its shell."

confirm() {
    # confirm STATE_KEY QUESTION: saved or interactive yes/no; returns 0 for yes.
    local saved answer
    saved="$(state_get "$1")"
    case "$saved" in
        yes) info "Using saved answer for $1: yes."; return 0 ;;
        no)
            info "Skipping: saved answer for $1 is no (reset: remove the $1 line from $STATE_FILE)."
            return 1
            ;;
    esac
    if ! answer="$(ask "$2 [y/N]: ")"; then
        warn "No terminal available to confirm; login shell left unchanged."
        return 2
    fi
    case "$answer" in
        [Yy] | [Yy][Ee][Ss]) state_set "$1" yes; return 0 ;;
        *) state_set "$1" no; return 1 ;;
    esac
}

snippet_body() {
    # snippet_body METHOD [DOMAIN]
    case "$1" in
        default_shell) printf '[domain/%s]\ndefault_shell = %s\n' "$2" "$ZSH_PATH" ;;
        domain_override_shell) printf '[domain/%s]\noverride_shell = %s\n' "$2" "$ZSH_PATH" ;;
        *) printf '[nss]\noverride_shell = %s\n' "$ZSH_PATH" ;;
    esac
}

manual_fix() {
    local body
    body="$(snippet_body "$@" | sed 's/$/\\n/' | tr -d '\n')"
    printf "Fix manually: printf '%s' | sudo tee %s && sudo chown root:root %s && sudo chmod 600 %s && sudo sss_cache -E && sudo systemctl restart sssd" \
        "$body" "$SSSD_SNIPPET" "$SSSD_SNIPPET" "$SSSD_SNIPPET"
}

SNIPPET_BACKUP=""

backup_snippet() {
    # Keep a root-only copy of an existing snippet (e.g. from an earlier run) so a
    # failed attempt restores it instead of deleting a working setting.
    SNIPPET_BACKUP=""
    [ -e "$SSSD_SNIPPET" ] || return 0
    if as_root_for "back up the existing $SSSD_SNIPPET before replacing it" \
        cp -p "$SSSD_SNIPPET" "$SSSD_SNIPPET.chezmoi-backup"; then
        SNIPPET_BACKUP="$SSSD_SNIPPET.chezmoi-backup"
        return 0
    fi
    warn "Could not back up the existing $SSSD_SNIPPET; leaving it unchanged."
    return 1
}

drop_backup() {
    [ -n "$SNIPPET_BACKUP" ] || return 0
    as_root_for "remove the backup $SNIPPET_BACKUP" rm -f "$SNIPPET_BACKUP" ||
        warn "Could not remove $SNIPPET_BACKUP; remove it manually."
    SNIPPET_BACKUP=""
}

SSSD_RESTART_REASON="clear the SSSD cache and restart sssd so it reads the new setting"

restart_sssd() {
    # One sudo call: while sssd is down, sudo cannot even look up an SSSD user.
    # reset-failed clears systemd's start limit (5 starts in 50s by default), which
    # trying default_shell and then override_shell can otherwise hit.
    as_root_for "$SSSD_RESTART_REASON" sh -c '
        sss_cache -E || echo "sss_cache -E failed; cached entries may be stale." >&2
        systemctl reset-failed sssd 2>/dev/null
        systemctl restart sssd'
}

restore_snippet() {
    # restore_snippet RESTART: put back the previous snippet (or remove ours) and, when
    # RESTART is "restart", restart sssd in the same sudo call so it is never left
    # stopped with a half-applied setting. 0 = restored (and restarted).
    local reason="remove the new $SSSD_SNIPPET again (restoring any previous version)"
    [ "$1" = "restart" ] && reason="$reason and restart sssd without it"
    as_root_for "$reason" sh -c '
        snippet=$1 backup=$2 restart=$3
        if [ -n "$backup" ]; then mv -f "$backup" "$snippet" || exit 1
        else rm -f "$snippet" || exit 1; fi
        [ "$restart" = restart ] || exit 0
        sss_cache -E 2>/dev/null
        systemctl reset-failed sssd 2>/dev/null
        systemctl restart sssd || exit 2' sh "$SSSD_SNIPPET" "$SNIPPET_BACKUP" "$1"
    case $? in
        0) SNIPPET_BACKUP=""; return 0 ;;
        2) warn "Could not restart sssd; run: sudo systemctl reset-failed sssd && sudo systemctl restart sssd" ;;
        *)
            if [ -n "$SNIPPET_BACKUP" ]; then
                warn "Could not restore $SSSD_SNIPPET from $SNIPPET_BACKUP; restore it manually and restart sssd."
            else
                warn "Could not remove $SSSD_SNIPPET; remove it manually and restart sssd."
            fi
            ;;
    esac
    return 1
}

account_uid() {
    getent passwd "$1" 2>/dev/null | head -n 1 | cut -d: -f3
}

find_sssd_domain() {
    # find_sssd_domain CANDIDATES: print the one candidate domain that serves $ACCOUNT,
    # verified through NSS by comparing the uid of ACCOUNT and ACCOUNT@DOMAIN.
    # Returns 1 if none match and 2 if several distinct domains match (ambiguous:
    # writing a per-domain setting could change the wrong domain's users); then the
    # matching names are printed instead.
    local uid name found="" found_lc name_lc
    uid="$(account_uid "$ACCOUNT")"
    [ -n "$uid" ] || return 1
    case "$ACCOUNT" in
        *@*)
            # Fully qualified user names already carry the domain.
            printf '%s\n' "${ACCOUNT#*@}"
            return 0
            ;;
    esac
    while IFS= read -r name; do
        name="${name//[[:space:]]/}"
        [ -n "$name" ] || continue
        [ "$(account_uid "$ACCOUNT@$name")" = "$uid" ] || continue
        if [ -z "$found" ]; then
            found="$name"
            continue
        fi
        found_lc="$(printf '%s' "$found" | tr '[:upper:]' '[:lower:]')"
        name_lc="$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]')"
        if [ "$found_lc" != "$name_lc" ]; then
            printf '%s, %s\n' "$found" "$name"
            return 2
        fi
    done <<< "$1"
    [ -n "$found" ] || return 1
    printf '%s\n' "$found"
}

config_domains() {
    # Domain names from the [domain/...] section headers of the SSSD configuration.
    printf '%s\n' "$1" | sed -n 's/^[[:space:]]*\[domain\/\([^]]*\)\][[:space:]]*$/\1/p'
}

domain_candidates() {
    # Configured domains first, then readable Kerberos/realmd hints.
    config_domains "$1"
    realm list --name-only 2>/dev/null
    klist 2>/dev/null | sed -n 's/^Default principal: .*@//p'
    sed -n 's/^[[:space:]]*default_realm[[:space:]]*=[[:space:]]*//p' "$KRB5_CONF" 2>/dev/null
}

apply_snippet() {
    # apply_snippet METHOD [DOMAIN]: write, validate, restart, verify.
    #   0 = shell changed (snippet kept)
    #   1 = sssd restarted fine but getent still shows another shell (snippet reverted):
    #       the only outcome that proves the setting has no effect
    # Anything else (write, validation, restart or rollback failure) warns and stops.
    local reason="write the SSSD setting to $SSSD_SNIPPET (root-only directory)"
    ensure_in_shells
    backup_snippet || finish
    if ! { as_root_for "$reason" mkdir -p "$SSSD_CONF_DIR" &&
        snippet_body "$@" | as_root_for "$reason" tee "$SSSD_SNIPPET" > /dev/null &&
        as_root_for "$reason" chown root:root "$SSSD_SNIPPET" &&
        as_root_for "$reason" chmod 600 "$SSSD_SNIPPET"; }; then
        warn "Could not write $SSSD_SNIPPET (sudo unavailable or denied). $(manual_fix "$@")"
        restore_snippet no-restart
        finish
    fi
    if command -v sssctl > /dev/null 2>&1 &&
        ! as_root_for "check the SSSD configuration with sssctl config-check" sssctl config-check > /dev/null; then
        restore_snippet no-restart
        warn "sssctl config-check rejected the configuration; reverted $SSSD_SNIPPET. Login shell left unchanged."
        finish
    fi
    if ! restart_sssd; then
        warn "sssd failed to restart with the new setting; reverting $SSSD_SNIPPET."
        restore_snippet restart
        warn "Login shell left unchanged. $(manual_fix "$@")"
        finish
    fi
    if [ "$(login_shell)" = "$ZSH_PATH" ]; then
        drop_backup
        info "Login shell is now $ZSH_PATH via $SSSD_SNIPPET ($1)."
        return 0
    fi
    if ! restore_snippet restart; then
        warn "Login shell left unchanged. $(manual_fix "$@")"
        finish
    fi
    return 1
}

if [ "$NEEDS_SUDO" = "true" ]; then
    info "Changing an SSSD account's shell needs sudo: SSSD's configuration is root-only and sssd must be restarted."
fi

confirm_or_finish() {
    # confirm_or_finish STATE_KEY QUESTION MANUAL_ARGS...: continue only on yes.
    local key="$1" question="$2"
    shift 2
    confirm "$key" "$question"
    case $? in
        0) return 0 ;;
        1) warn "Declined; login shell left unchanged. $(manual_fix "$@")" ;;
        *) warn "$(manual_fix "$@")" ;;
    esac
    finish
}

info "Option 1: set default_shell in your SSSD domain. It only affects users of that domain whose directory entry has no shell; users with a shell in the directory are unaffected."
case "$(state_get sssd_default_shell)" in
    ineffective)
        info "Skipping default_shell: an earlier run found that the directory sets a shell for $ACCOUNT (reset: remove the sssd_default_shell line from $STATE_FILE)."
        ;;
    *) confirm_or_finish sssd_default_shell "Set default_shell = $ZSH_PATH for your SSSD domain?" default_shell '<your domain>' ;;
esac

# sssd.conf and conf.d are root-only; their section names list the domains.
# Reading them is also the first sudo call, so a denial stops here.
if ! SSSD_CONFIG="$(as_root_for "read the root-only SSSD configuration ($SSSD_CONF and $SSSD_CONF_DIR) to find which domain your account belongs to" \
    sh -c 'cat "$1" 2>/dev/null; for f in "$2"/*.conf; do [ -f "$f" ] && cat "$f"; done; true' \
    sh "$SSSD_CONF" "$SSSD_CONF_DIR")"; then
    warn "sudo is unavailable or was denied; login shell left unchanged. $(manual_fix default_shell '<your domain>')"
    finish
fi

DOMAIN="$(find_sssd_domain "$(domain_candidates "$SSSD_CONFIG")")"
case $? in
    0) ;;
    2)
        # Not knowing which domain the account comes from, any per-domain or [nss]
        # override could change the wrong users: stop instead of guessing.
        warn "$ACCOUNT matches more than one SSSD domain ($DOMAIN) with the same uid, so the right domain cannot be chosen safely; login shell left unchanged. $(manual_fix default_shell '<your domain>')"
        finish
        ;;
    *) DOMAIN="" ;;
esac
if [ -n "$DOMAIN" ] && ! config_domains "$SSSD_CONFIG" | grep -qixF "$DOMAIN"; then
    # Guessed from Kerberos/realmd hints, not an SSSD section: try default_shell only.
    info "Your account appears to belong to $DOMAIN, which is not a section in the SSSD configuration."
    if [ "$(state_get sssd_default_shell)" != "ineffective" ] && apply_snippet default_shell "$DOMAIN"; then
        finish
    fi
    DOMAIN=""
fi
if [ -n "$DOMAIN" ]; then
    info "Your account belongs to SSSD domain $DOMAIN."
    if [ "$(state_get sssd_default_shell)" != "ineffective" ]; then
        if apply_snippet default_shell "$DOMAIN"; then
            finish
        fi
        info "default_shell had no effect: the directory sets a shell for $ACCOUNT, which takes precedence over default_shell."
        state_set sssd_default_shell ineffective
    fi
    # The directory sets a shell: override it, but only within this domain.
    info "Option 2: set override_shell in domain $DOMAIN. It replaces the login shell of EVERY user in $DOMAIN on this machine, including users whose directory entry sets a shell. Users of other SSSD domains and local accounts are unaffected."
    confirm_or_finish sssd_domain_override "Set override_shell = $ZSH_PATH for every user in $DOMAIN?" domain_override_shell "$DOMAIN"
    if ! apply_snippet domain_override_shell "$DOMAIN"; then
        warn "getent does not report $ZSH_PATH after setting override_shell for $DOMAIN; reverted $SSSD_SNIPPET. $(manual_fix domain_override_shell "$DOMAIN")"
    fi
    finish
fi

# Domain unknown: the only remaining choice is the machine-wide [nss] override.
info "Could not determine which SSSD domain serves $ACCOUNT, so no per-domain setting can be written."
info "Option 3: set override_shell in [nss], which changes the login shell for EVERY SSSD user of EVERY domain on this machine, including users whose directory entry sets a shell."
confirm_or_finish sssd_override "Set override_shell = $ZSH_PATH for every SSSD user?" override_shell
if ! apply_snippet override_shell; then
    warn "getent does not report $ZSH_PATH after setting override_shell; reverted $SSSD_SNIPPET. $(manual_fix override_shell)"
fi
finish
{{   end -}}
{{ end -}}
